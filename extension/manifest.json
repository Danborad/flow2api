{
  "manifest_version": 3,
  "name": "Flow2API Captcha Worker",
  "version": "1.1.9",
  "description": "Generate Google Labs reCAPTCHA Enterprise tokens for Flow2API.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://google.com/*",
    "https://*.google.com/*",
    "http://ai2.960916.xyz/*",
    "https://ai2.960916.xyz/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
